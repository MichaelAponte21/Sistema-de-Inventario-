# Base de datos
POSTGRES_DB=sistema_inventario
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Aplicación
DB_URL=jdbc:postgresql://host.docker.internal:7000/sistema_inventario
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Seed administrador (dejar APP_SEED_ADMIN=false si el usuario ya existe)
APP_SEED_ADMIN=false
APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=
APP_SEED_ADMIN_NOMBRE=Administrador
